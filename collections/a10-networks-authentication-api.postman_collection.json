          "name": "Sign On To ACOS",
          "request": {
            "name": "Sign On To ACOS",
            "description": {
              "content": "Authenticate with the ACOS device and receive a signature token. The returned signature must be sent in the `Authorization: A10 <signature>` header for every subsequent aXAPI request. Sessions expire after the device-configured idle timeout.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "axapi",
                "v3",
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the ACOS device or vThunder instance.",
                  "type": "any",
                  "value": "{{thunder-host}}",
                  "key": "thunder-host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentials\": {\n    \"username\": \"<string>\",\n    \"password\": \"<password>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "6577a6ee-164b-4dd4-8fe8-e933c741a3ff",
